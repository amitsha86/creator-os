// CreatorOS database schema
// Postgres on Vercel (Neon). User-mutated data persists here;
// static reference/analytics data stays in the seed module.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Content {
  id           String   @id @default(cuid())
  ownerId      String?
  title        String
  type         String
  stage        String
  assignee     String
  priority     String
  due          String
  platform     String
  retention    Int?
  hook         Int?
  emotional    Int?
  viral        Int?
  predictedCtr Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
}

model Deal {
  id           String   @id @default(cuid())
  ownerId      String?
  brand        String
  stage        String
  value        Int
  contact      String
  deliverables String
  health       String
  createdAt    DateTime @default(now())

  @@index([ownerId])
}

model VaultItem {
  id        String   @id @default(cuid())
  ownerId   String?
  kind      String
  title     String
  perf      Int
  tags      String[]
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Research {
  id         String   @id
  kind       String
  title      String
  source     String
  summary    String
  collection String
  createdAt  DateTime @default(now())
}

model CalendarPost {
  id       String @id
  title    String
  platform String
  day      Int
  time     String
}

model Competitor {
  id         String @id
  handle     String
  platform   String
  subs       Int
  growth     Float
  cadence    String
  topVideo   String
  topViews   Int
  thumbStyle String
}

model Opportunity {
  id          String   @id
  title       String
  niche       String
  viral       Int
  opportunity Int
  saturation  Int
  momentum    String
  why         String
  examples    String[]
  format      String
  spark       Int[]
}

model TeamMember {
  id       String @id
  name     String
  role     String
  initials String
  color    String
}

model Recommendation {
  id      String @id
  action  String
  impact  Int
  effort  String
  module  String
}
